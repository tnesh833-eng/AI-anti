rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened global validation primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile document validation
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email']) &&
        data.id is string && data.id == request.auth.uid &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 200;
    }

    // Quiz record validation
    function isValidQuizRecord(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'subject', 'topic', 'score', 'totalQuestions', 'percentage']) &&
        data.id is string && isValidId(data.id) &&
        data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
        data.subject is string && data.subject.size() > 0 && data.subject.size() <= 100 &&
        data.topic is string && data.topic.size() > 0 && data.topic.size() <= 150 &&
        data.score is number && data.score >= 0 &&
        data.totalQuestions is number && data.totalQuestions > 0 &&
        data.percentage is number && data.percentage >= 0 && data.percentage <= 100;
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && request.auth.uid == userId;
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) &&
        request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId);

      // Quiz diagnostic records subcollection
      match /quizRecords/{recordId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidQuizRecord(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidQuizRecord(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}

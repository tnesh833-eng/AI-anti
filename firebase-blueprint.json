{
  "entities": {
    "user": {
      "title": "User",
      "description": "Student user account and profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Student full name", "maxLength": 100 },
        "email": { "type": "string", "description": "Student email address" },
        "photoURL": { "type": "string", "description": "Student avatar URL" },
        "gradeLevel": { "type": "string", "description": "Academic grade level", "maxLength": 80 },
        "preferredSubject": { "type": "string", "description": "Primary study discipline", "maxLength": 80 },
        "streakDays": { "type": "number", "description": "Consecutive days study streak" },
        "xpPoints": { "type": "number", "description": "Total academic XP points earned" }
      },
      "required": ["id", "name", "email"]
    },
    "quizRecord": {
      "title": "QuizRecord",
      "description": "Historical adaptive quiz diagnostic record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Quiz record ID" },
        "userId": { "type": "string", "description": "Owner student user ID" },
        "subject": { "type": "string", "description": "Discipline tested" },
        "topic": { "type": "string", "description": "Topic or subtopic tested" },
        "score": { "type": "number", "description": "Correct answers" },
        "totalQuestions": { "type": "number", "description": "Total questions in quiz" },
        "percentage": { "type": "number", "description": "Score percentage 0-100" },
        "date": { "type": "string", "description": "Date of assessment" },
        "timeSpentSeconds": { "type": "number", "description": "Time spent in seconds" }
      },
      "required": ["id", "userId", "subject", "topic", "score", "totalQuestions", "percentage"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/user" },
      "description": "User profiles keyed by Auth UID"
    },
    "/users/{userId}/quizRecords/{recordId}": {
      "schema": { "$ref": "#/entities/quizRecord" },
      "description": "Quiz diagnostic histories for the authenticated student"
    }
  }
}
